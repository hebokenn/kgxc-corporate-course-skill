{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kgxc-course-plugin",
  "version": "0.9.0",
  "description": "DSH 课程工作台：资料、大纲、逐字稿、分镜、有声小样与整课交付。工程位于当前会话工作区。",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "酷果制课工作台",
        "shortDescription": "新建、恢复、审阅和导出课程，沿用已有确认。",
        "developerName": "酷果星创",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "用酷果制课工作台制作课程",
          "恢复课程并显示当前待确认内容"
        ]
      }
    }
  }
}
